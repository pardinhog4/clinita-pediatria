DATABASE_URL=postgresql://integrar:CHANGE_ME@127.0.0.1:5547/integrar
# Banco exclusivo dos testes, recriado a cada execução. Precisa terminar em _test.
TEST_DATABASE_URL=postgresql://integrar:CHANGE_ME@127.0.0.1:5547/integrar_test
POSTGRES_PASSWORD=CHANGE_ME
ACCESS_TOKEN_SECRET=GENERATE_WITH_NPM_RUN_SETUP_ENV
REFRESH_TOKEN_SECRET=GENERATE_WITH_NPM_RUN_SETUP_ENV
APP_ORIGIN=http://localhost:3005
DATABASE_SSL=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=
# E-mail (convites, nova senha, espelho de repasse) por SMTP genérico: Google Workspace,
# Microsoft 365, Amazon SES, Resend etc. Sem SMTP_HOST, os e-mails ficam em simulação
# (Integrações → E-mail) e nada sai da máquina.
SMTP_HOST=
SMTP_PORT=587
# true para a porta 465 (SSL direto); na 587 o envio usa STARTTLS.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Clínica Integrar <nao-responda@suaclinica.com.br>"
# Código exigido pelo cadastro inicial (/configuracao-inicial) quando APP_ORIGIN não é localhost.
SETUP_TOKEN=
